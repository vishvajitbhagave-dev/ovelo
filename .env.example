# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# 4. (Optional) Demo scanner key for the on-chain escrow (TEST wallet only).
#    The scanner is the address the escrow contract trusts to release funds.
#    Without it, the "Scan at gate" button cannot send the check-in.
SCANNER_PRIVATE_KEY=

# 5. (Optional) Override the Base Sepolia RPC used by the escrow module.
#    Defaults to the public https://sepolia.base.org if unset.
BASE_SEPOLIA_RPC_URL=

